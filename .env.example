# ── Database ──────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_USER=lpr_user
MYSQL_PASSWORD=your-db-password
MYSQL_DATABASE=metatraffic_lpr

# ── Session ───────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Twilio (SMS notifications + SMS 2FA) ──────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── AWS SES (email notifications + password reset) ────────────────────────
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_USER=your-ses-smtp-username
SES_SMTP_PASS=your-ses-smtp-password
SES_FROM_EMAIL=lpr@yourdomain.com

# ── App ───────────────────────────────────────────────────────────────────
# Full public URL — used in email links and photo URLs
BASE_URL=https://yourdomain.com

# Optional: override the base URL used in photo_url (defaults to BASE_URL/photos)
# PHOTO_BASE_URL=https://yourdomain.com/photos

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
